<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WeatherWidgetAdaptiveTextBase" parent="@android:style/Widget.TextView">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center_vertical|start</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.Primary" parent="WeatherWidgetAdaptiveTextBase">
        <item name="android:autoSizeMinTextSize">12dp</item>
        <item name="android:autoSizeMaxTextSize">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.LargePrimary" parent="WeatherWidgetAdaptiveText.Primary">
        <item name="android:autoSizeMaxTextSize">80sp</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.Medium" parent="WeatherWidgetAdaptiveTextBase">
        <item name="android:autoSizeMinTextSize">7dp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.LargeMedium" parent="WeatherWidgetAdaptiveText.Medium">
        <item name="android:autoSizeMaxTextSize">24sp</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.Regular" parent="WeatherWidgetAdaptiveTextBase">
        <item name="android:autoSizeMinTextSize">7dp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.LargeRegular" parent="WeatherWidgetAdaptiveText.Regular">
        <item name="android:autoSizeMaxTextSize">24sp</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.CompactMedium" parent="WeatherWidgetAdaptiveTextBase">
        <item name="android:autoSizeMinTextSize">7dp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.CompactRegular" parent="WeatherWidgetAdaptiveTextBase">
        <item name="android:autoSizeMinTextSize">7dp</item>
        <item name="android:autoSizeMaxTextSize">10sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.TinyRegular" parent="WeatherWidgetAdaptiveTextBase">
        <item name="android:autoSizeMinTextSize">7dp</item>
        <item name="android:autoSizeMaxTextSize">9sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetAdaptiveText.EmptyState" parent="WeatherWidgetAdaptiveTextBase">
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetTextOutlineLightBase">
        <item name="android:shadowColor">#FFFFFFFF</item>
        <item name="android:shadowRadius">1.25</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <style name="WeatherWidgetTextOutlineDarkBase">
        <item name="android:shadowColor">#FF111827</item>
        <item name="android:shadowRadius">1.25</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <style name="WeatherWidgetTextOutlineLightRegular" parent="WeatherWidgetTextOutlineLightBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetTextOutlineDarkRegular" parent="WeatherWidgetTextOutlineDarkBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetTextOutlineLightMedium" parent="WeatherWidgetTextOutlineLightBase">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetTextOutlineDarkMedium" parent="WeatherWidgetTextOutlineDarkBase">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="WeatherWidgetTextOutlineLightBold" parent="WeatherWidgetTextOutlineLightBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WeatherWidgetTextOutlineDarkBold" parent="WeatherWidgetTextOutlineDarkBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
